# ---------------------------------------------------------------------------
# Twin-Brain configuration.  Copy to `.env` and edit.  Every value is optional.
# The server also reads these from the real environment.
# ---------------------------------------------------------------------------

# --- network ---------------------------------------------------------------
# Default binds to loopback only (your memory never leaves the machine).
# Set to 0.0.0.0 ONLY if you know what you are doing (and set a strong token).
TWINBRAIN_HOST=127.0.0.1
TWINBRAIN_PORT=8765
# Comma-separated extra origins allowed to call the API (e.g. a dev dashboard).
# chrome-extension:// origins are always allowed.
TWINBRAIN_ALLOWED_ORIGINS=

# --- storage ---------------------------------------------------------------
# Directory for twinbrain.db, token.txt, logs. Default: ./data
TWINBRAIN_DATA_DIR=

# --- auth ------------------------------------------------------------------
# Leave empty to auto-generate a random token into <data>/token.txt on first run.
TWINBRAIN_TOKEN=
# 1 = a browser that loads the dashboard gets a session automatically (dev).
# 0 = you must paste the token on the dashboard's connect screen.
TWINBRAIN_AUTO_PAIR=1

# --- embeddings ------------------------------------------------------------
# auto | hash | st | openai
#   auto -> sentence-transformers if installed, else the offline hash embedder
#   st   -> all-MiniLM-L6-v2 via sentence-transformers (local, private, best)
#   hash -> built-in deterministic lexical embedder (zero deps, offline)
#   openai-> text-embedding-3-small via an OpenAI-compatible endpoint
TWINBRAIN_EMBEDDER=auto
TWINBRAIN_ST_MODEL=all-MiniLM-L6-v2
# OPENAI_BASE_URL also works for Ollama (http://localhost:11434/v1),
# LM Studio (http://localhost:1234/v1), vLLM, OpenRouter, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=
TWINBRAIN_EMBED_MODEL=text-embedding-3-small

# --- LLM -------------------------------------------------------------------
# auto | extractive | anthropic | openai
#   auto       -> anthropic if ANTHROPIC_API_KEY, else openai if OPENAI_API_KEY,
#                 else the built-in grounded extractive engine
#   extractive -> forced offline mode: assembles answers ONLY from retrieved
#                 text, so it can never hallucinate a memory
TWINBRAIN_LLM=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_CHAT_MODEL=gpt-4o-mini
# Any local OpenAI-compatible server (Ollama: "llama3.1", LM Studio, etc.)
TWINBRAIN_LOCAL_MODEL=

# --- web search (backend knowledge growth) ---------------------------------
# auto | duckduckgo | brave | tavily | serper | none
TWINBRAIN_WEBSEARCH=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
# Max backend web searches per day (hard budget). Default 40.
TWINBRAIN_WEBSEARCH_DAILY_BUDGET=40
# Max enrichment runs + notifications per day. Default 5 (per spec).
TWINBRAIN_ENRICHMENT_DAILY_BUDGET=5

# --- capture / retrieval tuning -------------------------------------------
TWINBRAIN_MIN_DWELL_SECONDS=5
TWINBRAIN_RETRIEVAL_TOP_K=8
TWINBRAIN_CANDIDATE_K=15
TWINBRAIN_SIMILARITY_WEIGHT=0.7
TWINBRAIN_RECENCY_WEIGHT=0.3
TWINBRAIN_MIN_GROUNDING_SCORE=0.20

# --- background jobs -------------------------------------------------------
TWINBRAIN_ENABLE_SCHEDULER=1
# Hour (0-23, local) of the daily digest / enrichment sweep.
TWINBRAIN_DIGEST_HOUR=20
# Retention: 0 = keep forever ("never forget"), N = auto-delete after N days.
TWINBRAIN_RETENTION_DAYS=0
