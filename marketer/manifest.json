{
  "manifest_version": 3,
  "name": "MarketerTwin — AI Digital Marketing & Meta Ads Expert",
  "short_name": "MarketerTwin",
  "version": "1.0.0",
  "description": "Your AI digital-marketing twin: Meta Ads expert, sales-psychology master, English + Roman Urdu, multi-chat memory, daily web-search learning, live page analysis, Facebook post/share automation with recorded click positions, and group monitoring. Everything stored in Chrome — no server needed.",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "contextMenus",
    "alarms",
    "notifications",
    "webNavigation",
    "debugger"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MarketerTwin — ask your marketing twin",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://*.web.facebook.com/*", "*://*.m.facebook.com/*"],
      "js": ["content/fb.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "open-app": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open the MarketerTwin studio"
    },
    "analyze-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Analyze the current page with MarketerTwin"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
